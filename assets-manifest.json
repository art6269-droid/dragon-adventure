  "dragonGrowthAssets": {
    "fallback": {
      "path": "assets/dragons/placeholder-dragon.png",
      "purpose": "Fallback image used when a dragon action asset is missing."
    },
    "matrix": {
      "pathPattern": "assets/dragons/{element}/{stage}/{action}.png",
      "elements": ["fire", "water", "wood", "light", "dark"],
      "stages": ["baby", "middle", "adult", "evolve"],
      "actions": ["idle", "sleep", "walk", "fly", "eat", "train", "attack"],
      "totalFiles": 140,
      "purpose": "Replaceable dragon growth and action placeholder assets for rest island, team, and future battle views."
    },
    "avatars": {
      "pathPattern": "assets/dragons/{element}/{stage}/avatar.png",
      "fallbackOrder": ["avatar.png", "idle.png", "assets/dragons/placeholder-dragon.png"],
      "purpose": "Independent dragon portrait assets for dragon detail panels and status panels."
    },
    "examples": [
      "assets/dragons/fire/baby/idle.png",
      "assets/dragons/fire/baby/avatar.png",
      "assets/dragons/water/middle/fly.png",
      "assets/dragons/dark/evolve/attack.png"
    ]
  },
